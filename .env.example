# ─────────────────────────────────────────────────────────────
#  UPTC Smart Parking — variables de entorno
#  Copiar a .env:   cp .env.example .env
#  (Docker Compose lee este archivo; los servicios Node también
#   lo cargan cuando se ejecutan fuera de Docker.)
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=America/Bogota

# Perfiles opcionales de Docker Compose (separados por coma):
#   local-db → PostgreSQL en contenedor (cambiar también DATABASE_URL, ver más abajo)
#   insight  → RedisInsight en http://localhost:5540
#   Ej.: COMPOSE_PROFILES=local-db,insight
COMPOSE_PROFILES=

# Redis (dentro de Docker el host es el nombre del servicio: "redis")
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Puertos
BACKEND_PORT=3000
FRONTEND_PORT=5173

# Simulador
#   SIMULATION_MODE: ACCELERATED_DEMO (1 min real = 1 h simulada) | REAL_TIME_PROFILE (hora real)
#   SIMULATION_INTERVAL_MS: 5000 = un ciclo cada 5 s; usar 2000 para la demostración en vivo
SIMULATION_INTERVAL_MS=5000
SIMULATION_MODE=ACCELERATED_DEMO
SIMULATION_START_TIME=06:30
SIMULATION_SEED=2026

# Crecimiento de Redis
STREAM_MAX_LENGTH=10000
TIMESERIES_MAX_LENGTH=5000
ALERTS_STREAM_MAX_LENGTH=2000
METRICS_SAMPLE_INTERVAL_MS=2000
HEARTBEAT_TTL_SECONDS=10
ALERT_COOLDOWN_SECONDS=30

# Umbrales (si se definen aquí, tienen prioridad sobre config/thresholds.json)
WARNING_OCCUPANCY=80
CRITICAL_OCCUPANCY=90
LOW_AVAILABILITY=5

# PostgreSQL — histórico permanente (servicio archiver)
#   Opción B (por defecto): PostgreSQL instalado en el equipo. Desde Docker,
#     "host.docker.internal" apunta al equipo anfitrión.
#   Opción A: PostgreSQL en contenedor → COMPOSE_PROFILES=local-db y esta línea:
#     DATABASE_URL=postgres://proyecto_electiva_1:Admin@postgres:5432/uptc_smart_parking
DATABASE_URL=postgres://proyecto_electiva_1:Admin@host.docker.internal:5432/uptc_smart_parking
ARCHIVE_SNAPSHOT_INTERVAL_MS=60000
ARCHIVE_RETENTION_DAYS=30

# Seguridad del panel de simulación (vacío = sin token, sólo para uso local)
DEMO_CONTROL_TOKEN=
CORS_ORIGIN=*

# Logging: debug | info | warn | error — formato: pretty | json
LOG_LEVEL=info
LOG_FORMAT=pretty
